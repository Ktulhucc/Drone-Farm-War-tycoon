local function getRootPart()
	local character = player.Character or player.CharacterAdded:Wait()
	return character:WaitForChild("HumanoidRootPart")
end


local function findCrashedDrone()
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("BasePart") and obj.Name:match("^CrashedDrone%d*$") then
			return obj
		end
	end
	return nil
end



gotoButton.MouseButton1Click:Connect(function()
	local rootPart = getRootPart()
	local drone = findCrashedDrone()

	if drone then
		rootPart.CFrame = drone.CFrame + Vector3.new(0, 5, 0) 
	else
		warn("CrashedDrone не найден.")
	end
end)

sellButton.MouseButton1Click:Connect(function()
	local rootPart = getRootPart()

	
	local targetPosition = Vector3.new(-1182.692138671875, 66.80099487304688, -4518.88427734375)
	rootPart.CFrame = CFrame.new(targetPosition)
end)
